// plistvalue — the values a property list holds.
//
// A date is its own kind and is a number.  The binary form stores a
// date as a big-endian 64-bit float: seconds from Apple's reference
// instant, 2001-01-01 00:00:00 UTC.  The XML form writes the same
// instant as ISO 8601 text ending in `Z`.  `PlistDate` carries the
// number, which survives both.  It is not a string, which a reader
// would have to recognise, and not a civil date, which needs a calendar
// and a time zone; calendar-nv is where those are.
//
// Data is its own kind too.  The XML form writes it as base64 text, and
// `PlistData` holds the decoded bytes.
//
// A dictionary keeps its order.  The binary form stores a dictionary
// as two parallel lists of references, in the order they were written,
// and the XML form is a sequence of elements.  Apple's tools do not
// sort.  Both forms can repeat a key, and `count_of` finds a repeat.

use std.list
use std.bytes

// A property list value.
//
// Eight kinds that both forms hold, plus two the binary form has alone.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println(plistvalue.kind_name(PlistBool(true)))   // boolean
// ```
pub enum PlistValue
    // `<true/>` or `<false/>`; binary markers `0x08` and `0x09`.
    PlistBool(v: Bool)
    // `<integer>`; binary marker `0x1`.  Signed, and the binary form
    // has a sixteen-byte width whose values do not fit an `Int` — see
    // `PlistBigInteger`.
    PlistInteger(v: Int)
    // An integer the binary form wrote in its sixteen-byte width, as
    // those sixteen bytes, big-endian two's complement.  An XML
    // `integer` outside the range of `Int` is read as one too, so the
    // two forms agree.  It is its own kind rather than a truncation,
    // because `-1` and `2^127 - 1` would otherwise read the same.
    PlistBigInteger(be_bytes: Bytes)
    // `<real>`; binary marker `0x2`.  A 64-bit float, and a 32-bit one
    // in the binary form widens to it losslessly.
    PlistReal(v: Float)
    // `<string>`; binary markers `0x5` (ASCII) and `0x6` (UTF-16
    // big-endian).  Held as UTF-8 whichever it was.  The binary writer
    // chooses ASCII when every character is ASCII and UTF-16 otherwise,
    // as Apple's writer does.
    PlistString(v: Str)
    // `<date>`; binary marker `0x33`.  Seconds from 2001-01-01
    // 00:00:00 UTC, which may be negative.
    PlistDate(seconds: Float)
    // `<data>`; binary marker `0x4`.  The bytes themselves, with the
    // XML form's base64 already decoded.
    PlistData(v: Bytes)
    // `<array>`; binary marker `0xA`.
    PlistArray(items: [PlistValue])
    // `<dict>`; binary marker `0xD`.
    PlistDict(entries: [PlistEntry])
    // Binary marker `0xC`: a set.  The XML document type has no
    // spelling for one, so writing one as XML is `PlistNoXmlSpelling`.
    PlistSet(items: [PlistValue])
    // Binary marker `0x8`: a UID, which is how NSKeyedArchiver points
    // from one object to another.  The XML document type has no
    // spelling for one.  Apple's tools convert it to a dictionary with a
    // `CF$UID` key, and `as_cfuid_dict` makes that conversion on
    // purpose.
    PlistUid(v: Int)

// One entry of a dictionary.
//
// A struct rather than a pair, because a list of two-element arrays is
// a different value.
pub struct PlistEntry
    // The key.  A property list key is always a string.
    key: Str
    // The value.
    value: PlistValue

// The kind's name, as Apple's documentation writes it:
// `"boolean"`, `"integer"`, `"real"`, `"string"`, `"date"`, `"data"`,
// `"array"`, `"dictionary"`, `"set"`, `"uid"`.
//
// What `PlistWrongKind` reports.
pub fn kind_name(v: PlistValue) -> Str []
    match v
        PlistBool(_)       => "boolean"
        PlistInteger(_)    => "integer"
        PlistBigInteger(_) => "integer"
        PlistReal(_)       => "real"
        PlistString(_)     => "string"
        PlistDate(_)       => "date"
        PlistData(_)       => "data"
        PlistArray(_)      => "array"
        PlistDict(_)       => "dictionary"
        PlistSet(_)        => "set"
        PlistUid(_)        => "uid"

// Whether the value can be written in the XML form.
//
// False for a set and a UID, and false for an array or dictionary
// that holds one at any depth.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println("${plistvalue.has_xml_spelling(PlistUid(3))}")   // false
// ```
pub fn has_xml_spelling(v: PlistValue) -> Bool []
    list.len(xml_blockers(v)) == 0

// The boolean a value holds, or `PlistWrongKind`.
pub fn as_bool(v: PlistValue) -> Result<Bool, PlistFault> []
    if let PlistBool(b) = v
        return Ok(b)
    Err(wrong("boolean", v))

// The integer a value holds, or `PlistWrongKind`.
//
// `PlistBigInteger` is `PlistWrongKind` here.  A caller that wants a
// truncation takes the bytes and makes it.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     match plistvalue.as_int(PlistInteger(7))
//         Ok(n)  => println("${n}")   // 7
//         Err(e) => println(e.message())
// ```
pub fn as_int(v: PlistValue) -> Result<Int, PlistFault> []
    if let PlistInteger(n) = v
        return Ok(n)
    Err(wrong("integer", v))

// The float a value holds, or `PlistWrongKind`.
pub fn as_float(v: PlistValue) -> Result<Float, PlistFault> []
    if let PlistReal(f) = v
        return Ok(f)
    Err(wrong("real", v))

// The string a value holds, or `PlistWrongKind`.
pub fn as_str(v: PlistValue) -> Result<Str, PlistFault> []
    if let PlistString(t) = v
        return Ok(t)
    Err(wrong("string", v))

// The bytes a data value holds, or `PlistWrongKind`.
pub fn as_data(v: PlistValue) -> Result<Bytes, PlistFault> []
    if let PlistData(b) = v
        return Ok(bytes.clone(b))
    Err(wrong("data", v))

// The seconds a date value holds, counted from 2001-01-01 00:00:00
// UTC, or `PlistWrongKind`.
//
// `unix_seconds` converts the number to seconds since the Unix epoch.
pub fn as_date_seconds(v: PlistValue) -> Result<Float, PlistFault> []
    if let PlistDate(t) = v
        return Ok(t)
    Err(wrong("date", v))

// The array a value holds, or `PlistWrongKind`.
pub fn as_array(v: PlistValue) -> Result<[PlistValue], PlistFault> []
    if let PlistArray(xs) = v
        return Ok(xs[:])
    Err(wrong("array", v))

// The dictionary entries a value holds, or `PlistWrongKind`.
pub fn as_dict(v: PlistValue) -> Result<[PlistEntry], PlistFault> []
    if let PlistDict(es) = v
        return Ok(es[:])
    Err(wrong("dictionary", v))

// One dictionary entry.
pub fn entry(key: Str, value: PlistValue) -> PlistEntry []
    PlistEntry { key: key, value: value }

// An empty dictionary.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println("${plistvalue.len(plistvalue.dict())}")   // 0
// ```
pub fn dict() -> PlistValue []
    PlistDict([])

// A dictionary from its entries, in the order given.
pub fn dict_of(entries: [PlistEntry]) -> PlistValue []
    PlistDict(entries[:])

// `d` with one more entry at the end, even when the key is already
// there, since both forms allow a repeated key.  `replace` changes an
// entry in place.  A value that is not a dictionary is answered
// unchanged.
pub fn append(d: PlistValue, key: Str, value: PlistValue) -> PlistValue []
    if let PlistDict(es) = d
        var out = es[:]
        list.push(out, entry(key, value))
        return PlistDict(out)
    d

// How many entries a dictionary has, or how many elements an array or a
// set has; `0` for a scalar.
pub fn len(v: PlistValue) -> Int []
    match v
        PlistArray(xs) => list.len(xs)
        PlistSet(xs)   => list.len(xs)
        PlistDict(es)  => list.len(es)
        _              => 0

// The value of the first entry with a key, or `PlistNoSuchKey`.  A
// value that is not a dictionary is `PlistWrongKind`.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     match plistvalue.get(plistvalue.dict(), "CFBundleName")
//         Ok(_)  => println("this cannot happen — the dictionary is empty")
//         Err(e) => println(e.message())
// ```
pub fn get(v: PlistValue, key: Str) -> Result<PlistValue, PlistFault> []
    if let PlistDict(es) = v
        for e in es
            if e.key == key
                return Ok(e.value)
        return Err(PlistNoSuchKey(key))
    Err(wrong("dictionary", v))

// The same lookup as an option.
pub fn lookup(v: PlistValue, key: Str) -> ?PlistValue []
    match get(v, key)
        Ok(found) => Some(found)
        Err(_)    => None

// How many entries carry this key.
//
// More than one is a repeated key.  Both forms allow one, and Apple's
// readers have kept the first in some versions and the last in others.
pub fn count_of(v: PlistValue, key: Str) -> Int []
    if let PlistDict(es) = v
        return list.count(es, e => e.key == key)
    0

// `d` with the first entry of this key given a new value, keeping its
// position, or with the entry appended when there was none.  A value
// that is not a dictionary is answered unchanged.
pub fn replace(d: PlistValue, key: Str, value: PlistValue) -> PlistValue []
    if let PlistDict(es) = d
        var out: [PlistEntry] = []
        var done = false
        for e in es
            if e.key == key and not done
                list.push(out, entry(key, value))
                done = true
            else
                list.push(out, e)
        if not done
            list.push(out, entry(key, value))
        return PlistDict(out)
    d

// `d` without any entry of this key.  A value that is not a dictionary
// is answered unchanged.
pub fn remove(d: PlistValue, key: Str) -> PlistValue []
    if let PlistDict(es) = d
        return PlistDict(list.filter(es, e => e.key != key))
    d

// The value at a path of dictionary keys, or `None`.
//
// Keys only.  A caller walking into an array takes the `PlistArray` and
// indexes the list itself.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     match plistvalue.path(plistvalue.dict(), ["a", "b"])
//         Some(_) => println("found")
//         None    => println("no such path")
// ```
pub fn path(v: PlistValue, keys: [Str]) -> ?PlistValue []
    var at = v
    for k in keys
        match lookup(at, k)
            Some(next) =>
                at = next
            None       =>
                return None
    Some(at)

// The Apple reference instant as Unix seconds: 978307200.
//
// 2001-01-01 00:00:00 UTC, the instant a property list date counts
// from.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println("${plistvalue.reference_epoch()}")   // 978307200
// ```
pub fn reference_epoch() -> Int []
    978307200

// A date's seconds converted to seconds since the Unix epoch.
//
// A `Float` on both sides, because a property list date has a
// fractional part.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println("${plistvalue.unix_seconds(0.0)}")   // 978307200
// ```
pub fn unix_seconds(reference_seconds: Float) -> Float []
    reference_seconds + 978307200.0

// The inverse: Unix seconds as seconds from the reference instant.
pub fn reference_seconds(unix: Float) -> Float []
    unix - 978307200.0

// The value with every UID in it, at any depth, replaced by the
// dictionary Apple's tools convert a UID to: one entry whose key is
// `CF$UID` and whose value is the integer.
//
// The result can be written as XML and no longer holds a UID; reading
// it back gives the dictionary.  The XML writer refuses a UID rather
// than making this conversion itself.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println("${plistvalue.len(plistvalue.as_cfuid_dict(PlistUid(3)))}")   // 1
// ```
pub fn as_cfuid_dict(v: PlistValue) -> PlistValue []
    match v
        PlistUid(n)    => dict_of([entry("CF\$UID", PlistInteger(n))])
        PlistArray(xs) => PlistArray(list.map(xs, as_cfuid_dict))
        PlistSet(xs)   => PlistSet(list.map(xs, as_cfuid_dict))
        PlistDict(es)  => PlistDict(list.map(es, cfuid_entry))
        _              => v

// The path of every value in the tree that has no XML spelling, in
// document order.
//
// A path is the dictionary keys and array indexes that reach the
// value, each after a `/`, and `/` alone for the root: `/items/2`.
//
// ```novo
// use plistvalue
//
// fn main() [io]
//     println("${list.len(plistvalue.xml_blockers(plistvalue.dict()))}")   // 0
// ```
pub fn xml_blockers(v: PlistValue) -> [Str] []
    var out: [Str] = []
    blockers_into(v, "", out)
    out

// The fault for a value of the wrong kind.
fn wrong(want: Str, v: PlistValue) -> PlistFault
    PlistWrongKind(want, kind_name(v))

// An entry with every UID in its value converted.
fn cfuid_entry(e: PlistEntry) -> PlistEntry
    entry(e.key, as_cfuid_dict(e.value))

// Push the path of every value under `v` with no XML spelling onto
// `out`.  `at` is the path of `v`.
fn blockers_into(v: PlistValue, at: Str, var out: [Str])
    match v
        PlistSet(_)    => list.push(out, shown_path(at))
        PlistUid(_)    => list.push(out, shown_path(at))
        PlistArray(xs) =>
            for i in 0..list.len(xs)
                blockers_into(xs[i], "${at}/${i}", out)
        PlistDict(es)  =>
            for e in es
                blockers_into(e.value, "${at}/${e.key}", out)
        _              => ()

// A path as it is reported: `/` for the root.
fn shown_path(at: Str) -> Str
    if at == ""
        return "/"
    at
