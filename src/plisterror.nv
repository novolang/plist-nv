// plisterror — every refusal, and where in the file each was found.
//
// One set of faults serves both forms, because the two forms hold the
// same document and a caller that reads whichever it is handed writes
// one match.  A fault from the binary reader carries a byte offset into
// the buffer; one from the XML reader carries a byte offset into the
// text and, where it helps, the element it was inside.
//
// A third kind of refusal concerns neither file: a value one form can
// hold and the other cannot.  A set and a UID exist in the binary form
// and have no spelling in the XML document type, so writing one as XML
// is `PlistNoXmlSpelling`.  `plistvalue.as_cfuid_dict` makes Apple's
// conversion of a UID on purpose.

// What went wrong.
pub enum PlistFault
    // The bytes are neither an XML property list nor a binary one.
    PlistUnknownFormat
    // The binary form's first six bytes are not `bplist`.  `saw` is the
    // first bytes in hexadecimal.
    PlistBadMagic(saw: Str)
    // The binary form's version is not `00`.  A later version has other
    // table widths, and reading it as `00` would read the wrong bytes.
    PlistUnsupportedBinaryVersion(saw: Str)
    // The buffer ended, or an object ran into the offset table, before
    // `need` bytes starting at `at` could be read.
    PlistTruncated(at: Int, need: Int)
    // The thirty-two-byte trailer's numbers do not describe the buffer:
    // a width that is not 1, 2, 4 or 8, an offset table outside the
    // buffer, no objects, more objects than the limit, or a root outside
    // the table.
    PlistBadTrailer(why: Str)
    // An entry of the offset table points before the first object or at
    // or past the offset table.
    PlistBadOffset(index: Int, offset: Int)
    // An object reference names an object index the table does not
    // have.
    PlistBadReference(at: Int, reference: Int)
    // An object marker the binary format does not assign, or one that
    // has no value here: the null object `0x00` and the fill byte
    // `0x0F`.
    PlistUnknownMarker(at: Int, marker: Int)
    // An integer whose width is not 1, 2, 4, 8 or 16 bytes, or a length
    // written as something other than an integer.
    PlistBadIntegerWidth(at: Int, width: Int)
    // A string whose bytes are not the encoding its marker declares:
    // ASCII for `0x5`, UTF-16 big-endian for `0x6`.
    PlistBadStringEncoding(at: Int)
    // A collection that holds itself, directly or further down.  Nothing
    // in the binary format forbids one, and a reader that followed it
    // would never return.
    PlistCycle(at: Int, reference: Int)
    // Collections nested deeper than the reader's limit.
    PlistDepthExceeded(at: Int, depth: Int)
    // The XML form's root element is not `plist`, its `version`
    // attribute is not `1.0`, or it does not hold exactly one value.
    PlistBadRoot(at: Int, saw: Str)
    // An element the property list document type does not define, or
    // one in a place it may not appear.
    PlistUnknownElement(at: Int, name: Str)
    // A `dict` whose children are not alternating `key` and value
    // elements, the one shape rule the document type cannot express.
    PlistBadDictShape(at: Int, why: Str)
    // An element whose text is not the shape it requires: an `integer`,
    // `real` or `date` that does not parse, or text where only elements
    // may be.
    PlistBadText(at: Int, element: Str, saw: Str)
    // A `data` element whose text is not base64.
    PlistBadBase64(at: Int)
    // The XML text is not well-formed XML.  `why` is xml-nv's own
    // sentence, so a caller needs no type of that package to show it.
    PlistBadXml(at: Int, why: Str)
    // A value with no spelling in the XML property list document type:
    // a set or a UID.
    PlistNoXmlSpelling(kind: Str)
    // An accessor was asked for one kind and the value was another.
    PlistWrongKind(want: Str, saw: Str)
    // A key the caller asked for is not in the dictionary.
    PlistNoSuchKey(key: Str)
    // A buffer larger than the reader's limit, with both sizes.
    PlistTooLarge(size: Int, most: Int)

// The one-line report: what was wrong, and where.
//
// ```novo
// use plisterror
//
// fn main() [io]
//     println(PlistBadOffset(3, 900).message())
// ```
impl Error for PlistFault
    // What was wrong, and the byte offset or element where it was.
    fn message(self) -> Str
        match self
            PlistUnknownFormat               => "the bytes are neither an XML nor a binary property list"
            PlistBadMagic(s)                 => "the binary form begins with bplist, and these bytes begin with ${s}"
            PlistUnsupportedBinaryVersion(s) => "binary property list version ${s} is not read; only 00 is"
            PlistTruncated(a, n)             => "${n} bytes are needed at byte ${a}, and the buffer does not hold them"
            PlistBadTrailer(w)               => "the trailer does not describe the buffer: ${w}"
            PlistBadOffset(i, o)             => "offset table entry ${i} points at byte ${o}, outside the objects"
            PlistBadReference(a, r)          => "object ${r}, referred to at byte ${a}, is not in the offset table"
            PlistUnknownMarker(a, m)         => "the marker ${m} at byte ${a} is not an object this package reads"
            PlistBadIntegerWidth(a, w)       => "an integer of ${w} bytes at byte ${a} is not a width the format has"
            PlistBadStringEncoding(a)        => "the string at byte ${a} is not in the encoding its marker declares"
            PlistCycle(a, r)                 => "object ${r}, referred to at byte ${a}, contains itself"
            PlistDepthExceeded(a, d)         => "the value at byte ${a} is nested ${d} deep, past the limit"
            PlistBadRoot(a, s)               => "the root at byte ${a} is not a plist element with one value: ${s}"
            PlistUnknownElement(a, n)        => "the element ${n} at byte ${a} is not allowed there"
            PlistBadDictShape(a, w)          => "the dict at byte ${a} does not alternate key and value: ${w}"
            PlistBadText(a, e, s)            => "the ${e} at byte ${a} holds '${s}', which is not its shape"
            PlistBadBase64(a)                => "the data at byte ${a} is not base64"
            PlistBadXml(a, w)                => "the text is not well-formed XML at byte ${a}: ${w}"
            PlistNoXmlSpelling(k)            => "a ${k} has no spelling in the XML property list form"
            PlistWrongKind(w, s)             => "wanted a ${w} and found a ${s}"
            PlistNoSuchKey(k)                => "the dictionary has no key ${k}"
            PlistTooLarge(s, m)              => "the buffer is ${s} bytes, and the limit is ${m}"

// The byte offset a fault was found at, or `0` for the faults that are
// about the document as a whole or about a value.
//
// ```novo
// use plisterror
//
// fn main() [io]
//     println("${plisterror.offset_of(PlistBadOffset(3, 900))}")   // 900
// ```
pub fn offset_of(f: PlistFault) -> Int []
    match f
        PlistTruncated(a, _)       => a
        PlistBadOffset(_, o)       => o
        PlistBadReference(a, _)    => a
        PlistUnknownMarker(a, _)   => a
        PlistBadIntegerWidth(a, _) => a
        PlistBadStringEncoding(a)  => a
        PlistCycle(a, _)           => a
        PlistDepthExceeded(a, _)   => a
        PlistBadRoot(a, _)         => a
        PlistUnknownElement(a, _)  => a
        PlistBadDictShape(a, _)    => a
        PlistBadText(a, _, _)      => a
        PlistBadBase64(a)          => a
        PlistBadXml(a, _)          => a
        _                          => 0

// A short, stable name for the fault, for a metric label or a test.
//
// The variant's spelling without the `Plist` prefix, in lower case with
// hyphens between the words: `"bad-magic"`, `"bad-trailer"`,
// `"no-xml-spelling"`.
//
// ```novo
// use plisterror
//
// fn main() [io]
//     println(plisterror.code_of(PlistUnknownFormat))   // unknown-format
// ```
pub fn code_of(f: PlistFault) -> Str []
    match f
        PlistUnknownFormat               => "unknown-format"
        PlistBadMagic(_)                 => "bad-magic"
        PlistUnsupportedBinaryVersion(_) => "unsupported-binary-version"
        PlistTruncated(_, _)             => "truncated"
        PlistBadTrailer(_)               => "bad-trailer"
        PlistBadOffset(_, _)             => "bad-offset"
        PlistBadReference(_, _)          => "bad-reference"
        PlistUnknownMarker(_, _)         => "unknown-marker"
        PlistBadIntegerWidth(_, _)       => "bad-integer-width"
        PlistBadStringEncoding(_)        => "bad-string-encoding"
        PlistCycle(_, _)                 => "cycle"
        PlistDepthExceeded(_, _)         => "depth-exceeded"
        PlistBadRoot(_, _)               => "bad-root"
        PlistUnknownElement(_, _)        => "unknown-element"
        PlistBadDictShape(_, _)          => "bad-dict-shape"
        PlistBadText(_, _, _)            => "bad-text"
        PlistBadBase64(_)                => "bad-base64"
        PlistBadXml(_, _)                => "bad-xml"
        PlistNoXmlSpelling(_)            => "no-xml-spelling"
        PlistWrongKind(_, _)             => "wrong-kind"
        PlistNoSuchKey(_)                => "no-such-key"
        PlistTooLarge(_, _)              => "too-large"

// Whether the fault says the bytes are malformed, rather than that the
// caller asked for something the value does not have.
//
// False for `PlistWrongKind`, `PlistNoSuchKey` and
// `PlistNoXmlSpelling`, which is about the value and not about anything
// read.
//
// ```novo
// use plisterror
//
// fn main() [io]
//     println("${plisterror.is_file_fault(PlistNoSuchKey("CFBundleName"))}")
// ```
pub fn is_file_fault(f: PlistFault) -> Bool []
    match f
        PlistNoXmlSpelling(_) => false
        PlistWrongKind(_, _)  => false
        PlistNoSuchKey(_)     => false
        _                     => true
