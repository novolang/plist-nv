// plistfmt — which form a property list is in, and the calls that
// read either form and convert between them.
//
// A property list's file name does not say which form it is in:
// `Info.plist` is XML in one application bundle and binary in the next.
// The form is decided by the first bytes and by nothing else.
//
// A conversion is a read and a write.  A binary file holding a set or a
// UID has no XML form, so converting it to XML answers
// `PlistNoXmlSpelling` rather than a file that lost something.

use std.bytes
use plistvalue
use plistbin
use plistxml

// Which form a property list is in.
//
// ```novo
// use plistfmt
//
// fn main() [io]
//     println(plistfmt.format_name(PlistBinaryForm))   // binary1
// ```
pub enum PlistForm
    // The XML document type: an `<?xml?>` declaration, the Apple
    // DOCTYPE and a `<plist>` element.
    PlistXmlForm
    // `bplist00` and its tables.
    PlistBinaryForm

// The name Apple's `plutil` uses for the form: `"xml1"`, `"binary1"`.
pub fn format_name(f: PlistForm) -> Str []
    match f
        PlistXmlForm    => "xml1"
        PlistBinaryForm => "binary1"

// The form a buffer is in, or `PlistUnknownFormat`.
//
// Decided by the first bytes: `bplist00` is the binary form, and a
// `<?xml`, a `<!DOCTYPE` or a `<plist` after any whitespace or
// byte-order mark is the XML one.  Nothing else is read, including the
// OpenStep text form.
//
// ```novo
// use std.bytes
// use plistfmt
//
// fn main() [io]
//     match plistfmt.detect(bytes.from_str("bplist00"))
//         Ok(f)  => println(plistfmt.format_name(f))   // binary1
//         Err(e) => println(e.message())
// ```
pub fn detect(src: Bytes) -> Result<PlistForm, PlistFault> []
    if plistbin.is_binary(src)
        return Ok(PlistBinaryForm)
    if plistxml.is_xml(bytes.to_str(bytes.slice(src, 0, min(bytes.len(src), 64))))
        return Ok(PlistXmlForm)
    Err(PlistUnknownFormat)

// The root value of a property list in either form.
//
// For a file whose form the caller does not know.
//
// ```novo
// use std.bytes
// use plistfmt
//
// fn main() [io]
//     match plistfmt.read(bytes.zeros(0))
//         Ok(_)  => println("this cannot happen — an empty buffer is not a file")
//         Err(e) => println(e.message())
// ```
pub fn read(src: Bytes) -> Result<PlistValue, PlistFault> []
    match detect(src)!
        PlistBinaryForm => plistbin.read(src)
        PlistXmlForm    => plistxml.read(bytes.to_str(src))

// The value written in a named form.
//
// `PlistNoXmlSpelling` when the form is XML and the value holds a set
// or a UID.
//
// ```novo
// use std.bytes
// use plistvalue
// use plistfmt
//
// fn main() [io]
//     match plistfmt.write(plistvalue.dict(), PlistBinaryForm)
//         Ok(b)  => println("${bytes.len(b)}")
//         Err(e) => println(e.message())
// ```
pub fn write(v: PlistValue, form: PlistForm) -> Result<Bytes, PlistFault> []
    match form
        PlistBinaryForm => plistbin.write(v)
        PlistXmlForm    =>
            let t = plistxml.write(v)!
            Ok(bytes.from_str(t))

// A file converted from whichever form it is in to a named one.
//
// A read and a write, as `plutil -convert` does.  A file already in the
// target form is read and written too, so the answer is in this
// package's layout rather than the file's.
//
// ```novo
// use std.bytes
// use plistfmt
//
// fn main() [io]
//     match plistfmt.convert(bytes.zeros(0), PlistXmlForm)
//         Ok(_)  => println("this cannot happen")
//         Err(e) => println(e.message())
// ```
pub fn convert(src: Bytes, to: PlistForm) -> Result<Bytes, PlistFault> []
    write(read(src)!, to)

// Whether a value can be written in a named form.
//
// True for every value in the binary form.  In the XML form, false for
// a value holding a set or a UID; a string with a control character is
// refused only when written.
//
// ```novo
// use plistvalue
// use plistfmt
//
// fn main() [io]
//     println("${plistfmt.can_write(PlistUid(3), PlistXmlForm)}")   // false
// ```
pub fn can_write(v: PlistValue, form: PlistForm) -> Bool []
    match form
        PlistBinaryForm => true
        PlistXmlForm    => plistvalue.has_xml_spelling(v)

// The smaller of two numbers.
fn min(a: Int, b: Int) -> Int
    if a < b
        return a
    b
